node User {
  id    String @id @default(cuid())
  email String @unique
  name  String @index
  follows User[] @out(FOLLOWS)
}

node Post {
  id     String @id
  title  String
  author User? @in(AUTHORED)
}

relationship Follows {
  type "FOLLOWS"
  from User
  to User
  since     DateTime @index
  requestId String   @unique
}
