{
  "name": "cyphra-example-trpc-nextjs",
  "private": true,
  "type": "module",
  "description": "Next.js App Router + tRPC v11 on Neo4j with Cyphra: generated zod schemas as tRPC inputs, typed errors, end-to-end types",
  "scripts": {
    "generate": "cyphra generate",
    "dev": "cyphra generate && next dev",
    "build": "cyphra generate && next build",
    "start": "next start",
    "push": "cyphra push",
    "test": "cyphra generate && vitest run",
    "typecheck": "cyphra generate && tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.2",
    "@trpc/client": "^11.29.7",
    "@trpc/server": "^11.29.7",
    "@trpc/tanstack-react-query": "^11.29.7",
    "cyphra": "workspace:*",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "superjson": "^2.2.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cyphra/cli": "workspace:*",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
