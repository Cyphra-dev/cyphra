{
  "name": "cyphra-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "build:grammar": "pnpm --filter @cyphra/schema run build:grammar",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "audit": "pnpm audit --audit-level=high",
    "bench": "pnpm --filter cyphra-bench run bench",
    "doc:dev": "pnpm --filter cyphra-doc dev",
    "doc:build": "pnpm --filter cyphra-doc build",
    "doc:lint-content": "pnpm --filter cyphra-doc lint:content",
    "doc:seo-audit": "pnpm --filter cyphra-doc seo:audit",
    "example:basic": "pnpm --filter cyphra-example-basic start",
    "changeset": "changeset",
    "example:blog": "pnpm --filter cyphra-example-blog start",
    "example:graphrag": "pnpm --filter cyphra-example-graphrag start"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.39.5",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.18": "^8.5.18",
      "nextra>zod": "4.3.6",
      "nextra-theme-docs>zod": "4.3.6"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-mrhx-c7xc-m3w5"
      ]
    }
  }
}
