// Auth of the native API: rules, authenticated, field rules, jwtContext (#245).

enum Role {
  MEMBER
  ADMIN
}

node User {
  id           String  @id
  email        String  @unique
  name         String
  role         Role    @default(MEMBER)
  salary       Int?
  passwordHash String?
  posts        Post[]  @relationship(type: "AUTHORED", direction: OUT)
  audits       Audit[] @relationship(type: "AUDITED", direction: IN)
}

node Post {
  id        String  @id @default(cuid())
  title     String
  published Boolean @default(false)
  views     Int     @default(0)
  author    User?   @relationship(type: "AUTHORED", direction: IN)
  tags      Tag[]   @relationship(type: "TAGGED", direction: OUT)
}

node Tag {
  name     String  @id
  internal Boolean @default(false)
  posts    Post[]  @relationship(type: "TAGGED", direction: IN)
}

node Audit {
  id      String @id
  message String
  user    User?  @relationship(type: "AUDITED", direction: OUT)
}
