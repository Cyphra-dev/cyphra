// Subscriptions of the native API on Neo4j Change Data Capture (#250): <model>Changed,
// relationship events, re-reads that apply the rules.

node User {
  id        String @id
  name      String
  posts     Post[] @relationship(type: "AUTHORED", direction: OUT)
  following User[] @relationship(type: "FOLLOWS", direction: OUT)
  followers User[] @relationship(type: "FOLLOWS", direction: IN)
}

node Post {
  id        String  @id
  title     String
  published Boolean @default(false)
  views     Int     @default(0)
  author    User?   @relationship(type: "AUTHORED", direction: IN)
  tags      Tag[]   @relationship(type: "TAGGED", direction: OUT)
}

node Tag {
  name     String  @id
  internal Boolean @default(false)
  posts    Post[]  @relationship(type: "TAGGED", direction: IN)
}

node Audit {
  id      String @id
  message String
}

relationship Follows {
  type  "FOLLOWS"
  from  User
  to    User
  since Int
}
