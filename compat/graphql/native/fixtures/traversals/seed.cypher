  (h)-[:FOLLOWS {since: 2022}]->(c), (b)-[:FOLLOWS {since: 2023}]->(d),
  (e1:Entity {id: "e1", name: "Neo4j"}), (e2:Entity {id: "e2", name: "Cypher"}),
