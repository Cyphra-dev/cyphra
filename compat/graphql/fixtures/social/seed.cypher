// Social: accounts follow each other (FOLLOWS carries since/muted), post statuses and like them.
CREATE (ana:Account {handle: "ana", displayName: "Ana", joined: datetime("2021-01-01T00:00:00Z")})
CREATE (bo:Account {handle: "bo", displayName: "Bo", joined: datetime("2021-06-15T12:00:00Z")})
CREATE (cleo:Account {handle: "cleo", displayName: "Cleo", joined: datetime("2022-03-03T03:03:03Z")})
CREATE (dev:Account {handle: "dev", displayName: "Dev", joined: datetime("2023-07-20T18:30:00Z")})
CREATE (eli:Account {handle: "eli", displayName: "Eli", joined: datetime("2024-02-29T09:00:00Z")})
CREATE (ana)-[:FOLLOWS {since: datetime("2021-07-01T00:00:00Z"), muted: false}]->(bo)
CREATE (ana)-[:FOLLOWS {since: datetime("2022-04-01T00:00:00Z"), muted: true}]->(cleo)
CREATE (bo)-[:FOLLOWS {since: datetime("2021-07-02T00:00:00Z"), muted: false}]->(ana)
CREATE (cleo)-[:FOLLOWS {since: datetime("2022-05-05T00:00:00Z"), muted: false}]->(ana)
CREATE (dev)-[:FOLLOWS {since: datetime("2023-08-01T00:00:00Z"), muted: false}]->(ana)
CREATE (dev)-[:FOLLOWS {since: datetime("2023-08-01T00:05:00Z"), muted: false}]->(bo)
CREATE (eli)-[:FOLLOWS {since: datetime("2024-03-01T00:00:00Z"), muted: true}]->(dev)
CREATE (s1:Status {id: "s-1", text: "hello world", postedAt: datetime("2021-01-02T10:00:00Z")})
CREATE (s2:Status {id: "s-2", text: "graphs are neat", postedAt: datetime("2022-01-10T11:00:00Z")})
CREATE (s3:Status {id: "s-3", text: "first post!", postedAt: datetime("2021-06-16T08:00:00Z")})
CREATE (s4:Status {id: "s-4", text: "cypher tip: use parameters", postedAt: datetime("2023-09-09T09:09:09Z")})
CREATE (s5:Status {id: "s-5", text: "leap day", postedAt: datetime("2024-02-29T10:00:00Z")})
CREATE (ana)-[:POSTED]->(s1)
CREATE (ana)-[:POSTED]->(s2)
CREATE (bo)-[:POSTED]->(s3)
CREATE (dev)-[:POSTED]->(s4)
CREATE (eli)-[:POSTED]->(s5)
CREATE (bo)-[:LIKES]->(s1)
CREATE (cleo)-[:LIKES]->(s1)
CREATE (dev)-[:LIKES]->(s1)
