// Org: companies, departments and employees; REPORTS_TO is a self-relationship; WORKS_AT carries employment details.
CREATE (acme:Company {name: "Acme", founded: date("1999-04-01")})
CREATE (globex:Company {name: "Globex", founded: date("2012-09-15")})
CREATE (eng:Department {name: "Engineering", budget: 1500000})
CREATE (sales:Department {name: "Sales", budget: 400000})
CREATE (research:Department {name: "Research", budget: 9007199254740993})
CREATE (acme)-[:HAS_DEPARTMENT]->(eng)
CREATE (acme)-[:HAS_DEPARTMENT]->(sales)
CREATE (globex)-[:HAS_DEPARTMENT]->(research)
CREATE (grace:Employee {id: "e-grace", name: "Grace", title: "CTO", active: true})
CREATE (linus:Employee {id: "e-linus", name: "Linus", title: "Staff Engineer", active: true})
CREATE (margaret:Employee {id: "e-margaret", name: "Margaret", title: "Engineer", active: true})
CREATE (dennis:Employee {id: "e-dennis", name: "Dennis", title: "Engineer", active: false})
CREATE (joan:Employee {id: "e-joan", name: "Joan", title: "Head of Sales", active: true})
CREATE (ken:Employee {id: "e-ken", name: "Ken", active: true})
CREATE (linus)-[:REPORTS_TO]->(grace)
CREATE (margaret)-[:REPORTS_TO]->(linus)
CREATE (dennis)-[:REPORTS_TO]->(linus)
CREATE (grace)-[:MEMBER_OF]->(eng)
CREATE (linus)-[:MEMBER_OF]->(eng)
CREATE (margaret)-[:MEMBER_OF]->(eng)
CREATE (margaret)-[:MEMBER_OF]->(research)
CREATE (dennis)-[:MEMBER_OF]->(eng)
CREATE (joan)-[:MEMBER_OF]->(sales)
CREATE (ken)-[:MEMBER_OF]->(research)
CREATE (grace)-[:WORKS_AT {since: date("2001-01-15"), role: "CTO", fullTime: true}]->(acme)
CREATE (linus)-[:WORKS_AT {since: date("2005-06-01"), role: "Engineer", fullTime: true}]->(acme)
CREATE (margaret)-[:WORKS_AT {since: date("2010-03-01"), role: "Engineer", fullTime: false}]->(acme)
CREATE (margaret)-[:WORKS_AT {since: date("2015-01-01"), role: "Advisor", fullTime: false}]->(globex)
CREATE (dennis)-[:WORKS_AT {since: date("2003-09-01"), role: "Engineer", fullTime: true}]->(acme)
CREATE (joan)-[:WORKS_AT {since: date("2008-11-11"), role: "Sales", fullTime: true}]->(acme)
CREATE (ken)-[:WORKS_AT {since: date("2013-02-01"), role: "Researcher", fullTime: true}]->(globex);
