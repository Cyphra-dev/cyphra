// Shop: customers place orders; order lines are CONTAINS edges carrying quantity and unit price.
CREATE (ada:Customer {id: "cust-ada", email: "ada@example.test", name: "Ada"})
CREATE (ben:Customer {id: "cust-ben", email: "ben@example.test", name: "Ben"})
CREATE (cy:Customer {id: "cust-cy", email: "cy@example.test", name: "Cy"})
CREATE (books:Category {name: "Books"})
CREATE (games:Category {name: "Games"})
CREATE (garden:Category {name: "Garden"})
CREATE (graphBook:Product {sku: "BK-001", name: "Graph Databases", price: 39.9, stock: 12, tags: ["database", "bestseller"]})
CREATE (cypherBook:Product {sku: "BK-002", name: "Learning Cypher", price: 29.5, stock: 0, tags: ["database"]})
CREATE (chess:Product {sku: "GM-001", name: "Chess Set", price: 59, stock: 4, tags: ["classic"]})
CREATE (go:Product {sku: "GM-002", name: "Go Board", price: 89.99, stock: 2, tags: ["classic", "bestseller"]})
CREATE (shovel:Product {sku: "GD-001", name: "Shovel", price: 19.99, stock: 30, tags: []})
CREATE (graphBook)-[:IN_CATEGORY]->(books)
CREATE (cypherBook)-[:IN_CATEGORY]->(books)
CREATE (chess)-[:IN_CATEGORY]->(games)
CREATE (go)-[:IN_CATEGORY]->(games)
CREATE (shovel)-[:IN_CATEGORY]->(garden)
CREATE (o1:Order {id: "ord-1", number: "A-1001", status: "PAID", placedAt: datetime("2024-05-01T10:00:00Z")})
CREATE (o2:Order {id: "ord-2", number: "A-1002", status: "SHIPPED", placedAt: datetime("2024-05-03T15:30:00Z")})
CREATE (o3:Order {id: "ord-3", number: "A-1003", status: "PENDING", placedAt: datetime("2024-06-11T08:15:00Z")})
CREATE (o4:Order {id: "ord-4", number: "A-1004", status: "CANCELLED", placedAt: datetime("2024-06-12T19:45:00Z")})
CREATE (ada)-[:PLACED]->(o1)
CREATE (ada)-[:PLACED]->(o3)
CREATE (ben)-[:PLACED]->(o2)
CREATE (cy)-[:PLACED]->(o4)
CREATE (o1)-[:CONTAINS {quantity: 1, unitPrice: 39.9}]->(graphBook)
CREATE (o1)-[:CONTAINS {quantity: 2, unitPrice: 29.5}]->(cypherBook)
CREATE (o2)-[:CONTAINS {quantity: 1, unitPrice: 59.0}]->(chess)
CREATE (o2)-[:CONTAINS {quantity: 3, unitPrice: 35.0}]->(graphBook)
CREATE (o3)-[:CONTAINS {quantity: 5, unitPrice: 19.99}]->(shovel)
CREATE (o4)-[:CONTAINS {quantity: 1, unitPrice: 89.99}]->(go);
