// Media: users favorite (rating/note edge properties) and watchlist movies and books through the
// `Content` union. Restricted books are only readable by librarians.
CREATE (ana:User {name: "ana"})
CREATE (bo:User {name: "bo"})
CREATE (cy:User {name: "cy"})
CREATE (dee:User {name: "dee"})
CREATE (arrival:Movie {title: "Arrival", year: 2016})
CREATE (heatMovie:Movie {title: "Heat", year: 1995})
CREATE (up:Movie {title: "Up", year: 2009})
CREATE (dune:Book {isbn: "b-dune", title: "Dune", pages: 412, restricted: false})
CREATE (heatBook:Book {isbn: "b-heat", title: "Heat", pages: 300, restricted: false})
CREATE (secret:Book {isbn: "b-secret", title: "Secret Files", restricted: true})
CREATE (scifi:Genre {name: "Sci-Fi"})
CREATE (crime:Genre {name: "Crime"})
CREATE (arrival)-[:IN_GENRE]->(scifi)
CREATE (heatMovie)-[:IN_GENRE]->(crime)
CREATE (ana)-[:FAVORITED {rating: 5, note: "a classic"}]->(arrival)
CREATE (ana)-[:FAVORITED {rating: 4}]->(dune)
CREATE (ana)-[:FAVORITED {rating: 3, note: "need-to-know"}]->(secret)
CREATE (bo)-[:FAVORITED {rating: 2}]->(heatMovie)
CREATE (bo)-[:FAVORITED {rating: 5, note: "better than the film"}]->(heatBook)
CREATE (dee)-[:FAVORITED {rating: 1}]->(up)
CREATE (ana)-[:WANTS]->(up)
CREATE (cy)-[:WANTS]->(dune)
CREATE (cy)-[:WANTS]->(arrival)
CREATE (cy)-[:WANTS]->(secret)
// The same movie twice on a watchlist: v7 returns it once (UNION of the member rows).
CREATE (dee)-[:WANTS]->(arrival)
CREATE (dee)-[:WANTS]->(arrival);
