// Benchmark schema: a small social app. The same labels, properties and relationship types are
// declared for @neo4j/graphql (src/contenders/graphql.ts) and neogma (src/contenders/neogma.ts).

node User {
  id        String    @id @default(uuid())
  email     String    @unique
  name      String
  age       Int       @index
  createdAt DateTime  @default(now())
  posts     Post[]    @out(AUTHORED, onDelete: Cascade)
  following User[]    @out(FOLLOWS)
  followers User[]    @in(FOLLOWS)
}

node Post {
  id        String    @id @default(uuid())
  title     String
  views     Int
  published Boolean   @default(false)
  author    User?     @in(AUTHORED)
  comments  Comment[] @out(HAS_COMMENT, onDelete: Cascade)
}

node Comment {
  id   String @id @default(uuid())
  text String
  post Post?  @in(HAS_COMMENT)
}

node Doc {
  id        String       @id @default(uuid())
  title     String
  embedding Vector(384)  @vectorIndex(similarity: cosine)
}
