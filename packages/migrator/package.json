{
  "name": "@cyphra/migrator",
  "version": "0.13.0",
  "description": "Versioned schema migrations for Neo4j: constraints, indexes and data migrations (Cyphra)",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cyphra/query": "workspace:*",
    "@cyphra/runtime": "workspace:*",
    "@cyphra/schema": "workspace:*"
  },
  "peerDependencies": {
    "neo4j-driver": "^5.28.3 || ^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "neo4j-driver": "^5.28.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cyphra-dev/cyphra.git",
    "directory": "packages/migrator"
  },
  "homepage": "https://www.cyphra.dev/migrations",
  "bugs": {
    "url": "https://github.com/Cyphra-dev/cyphra/issues"
  },
  "keywords": [
    "neo4j",
    "neo4j-orm",
    "orm",
    "typescript",
    "cypher",
    "graph-database",
    "cyphra",
    "migrations",
    "schema-migrations"
  ]
}
