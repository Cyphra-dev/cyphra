{
  "name": "@cyphra/graphql",
  "version": "0.11.0",
  "description": "GraphQL API for Neo4j on the Cyphra runtime, compatible with the API generated by @neo4j/graphql v7",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cyphra/runtime": "workspace:*",
    "@cyphra/schema": "workspace:*",
    "jose": "^6.2.18",
    "pluralize": "^8.0.0"
  },
  "peerDependencies": {
    "graphql": "^16.0.0",
    "neo4j-driver": "^5.28.3 || ^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pluralize": "^0.0.33",
    "graphql": "16.15.0",
    "neo4j-driver": "^5.28.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cyphra-dev/cyphra.git",
    "directory": "packages/graphql"
  },
  "homepage": "https://www.cyphra.dev/graphql",
  "bugs": {
    "url": "https://github.com/Cyphra-dev/cyphra/issues"
  },
  "keywords": [
    "graphql",
    "neo4j",
    "neo4j-graphql",
    "orm",
    "typescript",
    "cypher",
    "cyphra",
    "graph-database"
  ]
}
