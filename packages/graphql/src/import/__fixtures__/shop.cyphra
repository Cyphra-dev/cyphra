// Imported from @neo4j/graphql type definitions with `cyphra import graphql`.
// Review before use (run the import again to see the full report):
// - JSON: custom scalars are not supported by Cyphra: fields of this type are not converted
// - Product: a Cyphra node's name is its label: renamed to "Item"
// - Product.sku: @unique was removed in @neo4j/graphql v7; Cyphra keeps it and creates the uniqueness constraint
// - Product.attributes: custom scalars are not supported by Cyphra: not converted
// - Category.id: became @id @default(uuid()); Cyphra also adds a uniqueness constraint, which v7 @id does not
// - Customer.id: became @id @default(uuid()); Cyphra also adds a uniqueness constraint, which v7 @id does not
// - Order.id: became @id @default(uuid()); Cyphra also adds a uniqueness constraint, which v7 @id does not
// - Order.total: @cypher fields are computed by a Cypher query: not converted (compat.v7 still serves it); with the typed client, write it as a query
// - Review.id: became @id @default(uuid()); Cyphra also adds a uniqueness constraint, which v7 @id does not
// - Purchasable: v7 interfaces add no label and Product does not carry "Purchasable" through @node(labels); pass --add-interface-labels to map it to a Cyphra interface (the label must then be added to the existing nodes): not converted, nor the relationships to it; the implementations keep their own fields
// - Customer.wishlist: the interface "Purchasable" was not converted (see its entry): not converted

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
}

node Item {
  sku String @unique
  name String
  price Float
  stock BigInt?
  weightKg Float?
  location Point?
  tags String[]
  categories Category[] @out(IN_CATEGORY)
  reviews Review[] @in(REVIEWS)
  // attributes: JSON (not converted: type not supported)
}

node Category {
  id String @id @default(uuid())
  name String
  parent Category? @out(CHILD_OF)
  products Item[] @in(IN_CATEGORY)
}

node Customer {
  id String @id @default(uuid())
  email String
  orders Order[] @out(PLACED)
  // wishlist: [Purchasable!]! (not converted: relationship not converted)
}

node Order {
  id String @id @default(uuid())
  status OrderStatus @default(PENDING)
  placedAt DateTime @default(now())
  deliveryWindow LocalTime?
  customer Customer @in(PLACED)
  lines Item[] @out(CONTAINS)
  // total: Float (not converted: computed field)
}

node Review {
  id String @id @default(uuid())
  stars Int
  body String?
  product Item @out(REVIEWS)
}

relationship OrderLine {
  type "CONTAINS"
  from Order
  to Item
  quantity Int @default(1)
  unitPrice Float
  addedAt DateTime? @default(now())
}
