// Imported from @neo4j/graphql type definitions with `cyphra import graphql`.
// Review before use (run the import again to see the full report):
// - Lab.id: became @id @default(uuid()); Cyphra also adds a uniqueness constraint, which v7 @id does not
// - Quiz.id: became @id @default(uuid()); Cyphra also adds a uniqueness constraint, which v7 @id does not
// - LearningActivity: mapped to interface LearningActivity, implemented by Lab and Quiz, which carry its label through @node(labels) (Cyphra writes and matches it, like v7); it declares their common fields id, title, durationMinutes and skills; the uniqueness of id now spans every :LearningActivity node (one constraint on :LearningActivity instead of one per label)
// - Rated: v7 interfaces add no label and Review does not carry "Rated" through @node(labels); pass --add-interface-labels to map it to a Cyphra interface (the label must then be added to the existing nodes): not converted, nor the relationships to it; the implementations keep their own fields
// - Catalogued: label shared by Course and Path: mapped to interface Catalogued (Cyphra writes and matches the label, like v7); it declares their common fields code and name
// - Person: label of Learner: mapped to interface Person (Cyphra writes and matches the label, like v7); it declares no field
// - Badge: label "Award" became @@labels([Award]) (the fields do not line up: field "level" differs: Badge has `level String`, Certificate has `level Int`): Cyphra matches Badge nodes with or without it and does not add it on create; add it with `$labels: { add: ["Award"] }`
// - Certificate: label "Award" became @@labels([Award]) (the fields do not line up: field "level" differs: Badge has `level String`, Certificate has `level Int`): Cyphra matches Certificate nodes with or without it and does not add it on create; add it with `$labels: { add: ["Award"] }`
// - Mentor: label "Learner" is the label of node Learner: a Mentor would also be read as a Learner, which Cyphra cannot express; not converted
// - Review.about: the interface "Rated" was not converted (see its entry): not converted

interface LearningActivity {
  id String @id @default(uuid())
  title String
  durationMinutes Int?
  skills Skill[] @out(TEACHES)
}

interface Catalogued {
  code String
  name String
}

interface Person {
}

node Lab implements LearningActivity {
  environment String
}

node Quiz implements LearningActivity {
  passMark Int
}

node Skill {
  name String
  activities LearningActivity[] @in(TEACHES)
}

node Course implements Catalogued {
  activities LearningActivity[] @out(INCLUDES)
}

node Path implements Catalogued {
  courses Course[] @out(STEP)
}

node Learner implements Person {
  email String
  completed LearningActivity[] @out(COMPLETED)
}

node Badge {
  level String

  @@labels([Award])
}

node Certificate {
  level Int

  @@labels([Award])
}

node Mentor {
  email String
}

node Review {
  rating Float?
  text String?
  // about: [Rated!]! (not converted: relationship not converted)
}

relationship Teaches {
  type "TEACHES"
  from LearningActivity
  to Skill
  weight Float?
}
