node Book {
  isbn String
  title String
  summary String?
  year Int
  authors Author[] @relationship(type: "WROTE", direction: IN)
  reviews Review[] @relationship(type: "REVIEWS", direction: IN)
  // reviewCount: Int! (not converted: computed field)
  // averageRating: Float (not converted: computed field)
  // keywords: [String!]! (not converted: computed field)
  // related: [Book!]! (not converted: computed field)
  // firstAuthor: Author (not converted: computed field)
  // writers: [Author!]! (not converted: computed field)
  // reviewedByViewer: Boolean! (not converted: computed field)

  @@fulltext([title], name: "BookTitle")
  @@fulltext([title, summary], name: "BookText")
}

node Author {
  name String
  born Int?
  books Book[] @relationship(type: "WROTE", direction: OUT)
  // bookCount: Int! (not converted: computed field)
}

node Review {
  rating Int
  by String
  book Book[] @relationship(type: "REVIEWS", direction: OUT)
}

relationship Wrote {
  type "WROTE"
  from Author
  to Book
  position Int
  // credit: String (not converted: computed field)
}
