// Imported from a Prisma schema with `cyphra import prisma`.
// Review before use (run the import again to see the full report):
// - User.profile: Neo4j has no constraint across relationships, so a second HAS_PROFILE edge is not refused by the database; the client replaces the edge when you connect another node
// - User.followers: self relation: User.followers became the OUT side of FOLLOWS (and following the IN side); check that it matches column A of the _Follows join table when you migrate the data
// - User.name: the column length became @length(max: 80), checked by the Cyphra client on every write (Neo4j strings have no length limit)
// - User.updatedAt: became @default(now()): set on create, but Cyphra does not refresh it on update; set it in your updates
// - Profile.id: Neo4j has no sequences: not converted; keep the existing ids when you migrate the data, and set new ones yourself (or switch to String @id @default(cuid()))
// - Profile.userId: dropped: the HAS_PROFILE edge of user replaces the key (Neo4j links nodes with edges, not key columns)
// - Post: table names are not kept: the node label is the model name
// - Post.title: the column length became @length(max: 200), checked by the Cyphra client on every write (Neo4j strings have no length limit)
// - Post.publishedAt: column names are not kept: the Neo4j property is the field name (Prisma Client returns field names, so export through it)
// - Post.authorId: dropped: the HAS_POSTS edge of author replaces the key (Neo4j links nodes with edges, not key columns)
// - Comment.postId: dropped: the HAS_COMMENTS edge of post replaces the key (Neo4j links nodes with edges, not key columns)
// - Comment.authorId: dropped: the HAS_COMMENTS edge of author replaces the key (Neo4j links nodes with edges, not key columns)
// - Tag.id: Neo4j has no sequences: not converted; keep the existing ids when you migrate the data, and set new ones yourself (or switch to String @id @default(cuid()))

enum Role {
  USER
  EDITOR
  ADMIN
}

node User {
  id String @id @default(cuid())
  email String @unique
  name String? @length(max: 80)
  role Role @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  posts Post[] @out(HAS_POSTS, onDelete: Cascade)
  comments Comment[] @out(HAS_COMMENTS)
  profile Profile? @out(HAS_PROFILE, onDelete: Cascade)
  followers User[] @out(FOLLOWS)
  following User[] @in(FOLLOWS)
}

node Profile {
  id Int @id
  bio String?
  avatar String?
  user User @in(HAS_PROFILE)
  // userId String (foreign key of user: replaced by the edge)
}

node Post {
  id String @id @default(uuid())
  title String @length(max: 200)
  slug String @unique
  content String?
  published Boolean @default(false)
  views Int @default(0)
  publishedAt DateTime?
  author User @in(HAS_POSTS)
  tags Tag[] @out(HAS_TAGS)
  comments Comment[] @out(HAS_COMMENTS, onDelete: Cascade)
  // authorId String (foreign key of author: replaced by the edge)

  @@index([published, publishedAt])
}

node Comment {
  id String @id @default(cuid())
  body String
  createdAt DateTime @default(now())
  post Post @in(HAS_COMMENTS)
  author User? @in(HAS_COMMENTS)
  // postId String (foreign key of post: replaced by the edge)
  // authorId String? (foreign key of author: replaced by the edge)
}

node Tag {
  id Int @id
  name String @unique
  posts Post[] @in(HAS_TAGS)
}
