{
  "name": "@cyphra/schema",
  "version": "0.19.0",
  "description": "Cyphra schema DSL parser and AST for Neo4j graph models",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build:grammar": "peggy --format es -o src/generated/parser.js grammar.peggy",
    "build": "pnpm run build:grammar && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "neogma": "2.0.5",
    "peggy": "^4.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cyphra-dev/cyphra.git",
    "directory": "packages/schema"
  },
  "homepage": "https://www.cyphra.dev/schema",
  "bugs": {
    "url": "https://github.com/Cyphra-dev/cyphra/issues"
  },
  "keywords": [
    "neo4j",
    "neo4j-orm",
    "orm",
    "typescript",
    "cypher",
    "graph-database",
    "cyphra",
    "schema",
    "dsl"
  ]
}
