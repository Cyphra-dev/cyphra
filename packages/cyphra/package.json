{
  "name": "cyphra",
  "version": "0.2.1",
  "description": "Cyphra — the TypeScript ORM for Neo4j: typed client, schema DSL, Cypher helpers and migrations",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cyphra/migrator": "workspace:*",
    "@cyphra/query": "workspace:*",
    "@cyphra/runtime": "workspace:*",
    "@cyphra/schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "keywords": [
    "neo4j",
    "cypher",
    "graph",
    "schema",
    "migrations",
    "neo4j-orm",
    "orm",
    "typescript",
    "graph-database",
    "cyphra",
    "type-safe"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cyphra-dev/cyphra.git",
    "directory": "packages/cyphra"
  },
  "homepage": "https://www.cyphra.dev",
  "bugs": {
    "url": "https://github.com/Cyphra-dev/cyphra/issues"
  }
}
