// Unions: a type over unrelated nodes. It adds no label: SearchHit nodes are Articles, Authors
// and Staff (a Staff node is also a :Member).
union SearchHit = Article | Author | Staff

interface Member {
  id    String @id @default(cuid())
  email String @unique
}

node Staff implements Member {
  role String @default("editor")
}

node Article {
  id    String @id @default(cuid())
  title String @length(max: 200)
  pin   Pin?   @relationship(type: "PINS", direction: IN)
  notes Note[] @relationship(type: "HAS_NOTE", direction: OUT, onDelete: Cascade)
}

node Author {
  id     String @id @default(cuid())
  name   String @unique
  rating Int?
}

node Note {
  id   String @id @default(cuid())
  text String
}

node Board {
  id    String      @id @default(cuid())
  name  String
  items SearchHit[] @relationship(type: "SHOWS", direction: OUT, onDelete: Cascade)
}

node Pin {
  id      String     @id @default(cuid())
  label   String
  subject SearchHit? @relationship(type: "PINS", direction: OUT)
}
