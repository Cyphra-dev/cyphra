{
  "name": "@cyphra/runtime",
  "version": "0.31.0",
  "description": "Cyphra runtime: typed Neo4j OGM (object-graph mapper) client, sessions, transactions and the cypher tag, over Bolt or HTTP (edge runtimes), with Memgraph and FalkorDB dialects",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "workerd": "./dist/edge.js",
      "edge-light": "./dist/edge.js",
      "worker": "./dist/edge.js",
      "import": "./dist/index.js"
    },
    "./edge": {
      "types": "./dist/index.d.ts",
      "import": "./dist/edge.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cyphra/query": "workspace:*",
    "@cyphra/schema": "workspace:*"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.4.0",
    "neo4j-driver": "^5.28.3 || ^6.0.0",
    "falkordb": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "falkordb": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^2.12.1",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@types/node": "^22.20.5",
    "esbuild": "^0.27.7",
    "falkordb": "^7.0.1",
    "neo4j-driver": "^5.28.3",
    "neo4j-driver-5": "npm:neo4j-driver@^5.28.3",
    "neo4j-driver-6": "npm:neo4j-driver@^6.3.2",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12",
    "zod": "^4.6.7",
    "zod3": "npm:zod@^3.25.76"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cyphra-dev/cyphra.git",
    "directory": "packages/runtime"
  },
  "homepage": "https://www.cyphra.dev/runtime",
  "bugs": {
    "url": "https://github.com/Cyphra-dev/cyphra/issues"
  },
  "keywords": [
    "neo4j",
    "neo4j-orm",
    "orm",
    "typescript",
    "cypher",
    "graph-database",
    "cyphra",
    "neo4j-driver",
    "transactions",
    "opentelemetry",
    "logging",
    "edge",
    "cloudflare-workers",
    "vercel-edge",
    "neo4j-query-api",
    "falkordb",
    "memgraph",
    "graphrag"
  ]
}
