{
  "name": "@cyphra/runtime",
  "version": "0.1.0",
  "description": "Neo4j execution layer for Cyphra: typed ORM client, sessions, transactions, and cypher tag",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cyphra/query": "workspace:*",
    "@cyphra/schema": "workspace:*",
    "neo4j-driver": "^5.27.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.0.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cyphra-dev/cyphra.git",
    "directory": "packages/runtime"
  },
  "homepage": "https://cyphra-doc.vercel.app",
  "bugs": {
    "url": "https://github.com/Cyphra-dev/cyphra/issues"
  }
}
