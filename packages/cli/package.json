{
  "name": "@cyphra/cli",
  "version": "0.15.0",
  "description": "Cyphra CLI for the TypeScript Neo4j ORM: init, generate, migrate, push, pull and a local data browser (studio)",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "cyphra": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup && node scripts/build-studio.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/studio/ui",
    "test": "vitest run"
  },
  "dependencies": {
    "@cyphra/graphql": "workspace:*",
    "@cyphra/migrator": "workspace:*",
    "@cyphra/runtime": "workspace:*",
    "@cyphra/schema": "workspace:*",
    "commander": "^12.1.0",
    "graphql": "^16.11.0",
    "neo4j-driver": "^5.28.3 || ^6.0.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.27.7",
    "tsup": "^8.5.1",
    "vitest": "^4.1.12"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cyphra-dev/cyphra.git",
    "directory": "packages/cli"
  },
  "homepage": "https://www.cyphra.dev/cli",
  "bugs": {
    "url": "https://github.com/Cyphra-dev/cyphra/issues"
  },
  "keywords": [
    "neo4j",
    "neo4j-orm",
    "orm",
    "typescript",
    "cypher",
    "graph-database",
    "cyphra",
    "cli",
    "migrations"
  ]
}
