{
  "name": "@cyphra/query",
  "version": "0.27.0",
  "description": "Cypher-first query utilities for Neo4j: template tag and fluent builder (Cyphra)",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cyphra-dev/cyphra.git",
    "directory": "packages/query"
  },
  "homepage": "https://www.cyphra.dev/queries",
  "bugs": {
    "url": "https://github.com/Cyphra-dev/cyphra/issues"
  },
  "keywords": [
    "neo4j",
    "neo4j-orm",
    "orm",
    "typescript",
    "cypher",
    "graph-database",
    "cyphra",
    "query-builder"
  ]
}
